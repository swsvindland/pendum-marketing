{
  "name": "vector-marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/vector-web.mjs check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens": "node scripts/vector-web.mjs gen",
    "tokens:pull": "node scripts/vector-web.mjs pull",
    "check": "pnpm tokens && pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "ionicons": "^8.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.18.0"
}
